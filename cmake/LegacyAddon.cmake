# Builds a C++17 native addon with the same architecture as its server.
function(legacy_addon NAME)
    if(NOT CMAKE_SIZEOF_VOID_P EQUAL 4)
        message(FATAL_ERROR "Legacy Server addons require a 32-bit toolchain (Windows: -A Win32; Linux: an i686/multilib toolchain)")
    endif()
    add_library(${NAME} SHARED ${ARGN})
    target_compile_features(${NAME} PRIVATE cxx_std_17)
    target_include_directories(${NAME} PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../include")
    set_target_properties(${NAME} PROPERTIES PREFIX "" CXX_EXTENSIONS OFF)
    if(MSVC)
        target_compile_options(${NAME} PRIVATE /W4 /utf-8 /permissive-)
        target_compile_definitions(${NAME} PRIVATE WIN32_LEAN_AND_MEAN NOMINMAX _CRT_SECURE_NO_WARNINGS)
    else()
        target_compile_options(${NAME} PRIVATE -Wall -Wextra -fvisibility=hidden)
    endif()
endfunction()
